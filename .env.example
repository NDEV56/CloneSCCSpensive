# =====================================================
# Supabase — EduKas SMP Masyithoh Kroya
# Copy file ini menjadi .env, lalu isi nilainya.
# =====================================================
# Ambil dari Supabase Dashboard > Project Settings > API
# Gunakan anon public key, JANGAN service_role key.
#
# ADMIN_ACCESS_KEY = kunci izin admin (langkah verifikasi ke-2).
# Buat acak minimal 12 karakter, jangan sama dengan sandi admin.
# Kunci ini dienkripsi AES-256-GCM saat build; nilai aslinya tidak
# pernah dikirim ke browser.
#
# Untuk Vercel: jangan upload file .env ke GitHub.
# Masukkan SUPABASE_URL, SUPABASE_ANON_KEY, dan ADMIN_ACCESS_KEY di
# Vercel > Project Settings > Environment Variables,
# lalu Redeploy. Generator akan membaca dari sana.

SUPABASE_URL=https://GANTI-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=GANTI-DENGAN-ANON-PUBLIC-KEY
ADMIN_ACCESS_KEY=GANTI-KUNCI-ADMIN-MINIMAL-12-KARAKTER
